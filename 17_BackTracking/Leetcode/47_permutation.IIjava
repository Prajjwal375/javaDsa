class Solution {
    public List<List<Integer>> permuteUnique(int[] nums) {
        List<List<Integer>> ans = new ArrayList<>();
        Arrays.sort(nums);
        boolean[] used = new boolean[nums.length];
        findPermutation(ans, nums, new ArrayList<>(), used);
        return ans;
    }

    public void findPermutation(List<List<Integer>> ans, int[] nums, List<Integer>curr, boolean[] used){
        // base case
        if(curr.size() == nums.length){
            ans.add(new ArrayList<>(curr));
            return;
        }
        // choice
        for(int i = 0; i< nums.length; i++){

             // for duplicates
            if(i> 0 && nums[i] == nums[i-1] && !used[i-1]){
                continue;
            }

            if(used[i]){
                continue;
            }
            used[i] =  true;
            curr.add(nums[i]);
            findPermutation(ans, nums, curr, used);
    

            // backtracking
            curr.remove(curr.size()-1);
            used[i] = false;
            
        }
    }
}